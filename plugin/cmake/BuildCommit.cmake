# Writes OUT, a header with the commit the plugin is built from (`git describe --always --dirty`
# in ROOT), or "unknown" where ROOT is no git checkout (a source tarball) or GIT is missing.
# Run at every build (cmake -P, portable); the file changes only when the commit does, so only
# what includes it compiles again.
set(commit "unknown")
if(GIT AND EXISTS "${ROOT}/.git") # a directory, or a file in a worktree
  execute_process(COMMAND "${GIT}" describe --always --dirty
    WORKING_DIRECTORY "${ROOT}"
    OUTPUT_VARIABLE out
    RESULT_VARIABLE result
    OUTPUT_STRIP_TRAILING_WHITESPACE
    ERROR_QUIET)
  if(result EQUAL 0 AND out MATCHES "^[A-Za-z0-9._/+-]+$")
    set(commit "${out}")
  endif()
endif()
set(text "// generated by plugin/cmake/BuildCommit.cmake at build time\n#define PE_BUILD_COMMIT \"${commit}\"\n")
set(old "")
if(EXISTS "${OUT}")
  file(READ "${OUT}" old)
endif()
if(NOT old STREQUAL text)
  file(WRITE "${OUT}" "${text}")
endif()
